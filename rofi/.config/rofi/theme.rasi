* {
    bg: rgba(24, 24, 37, 0.98);
    bg-alt: rgba(30, 30, 46, 1.0);
    bg-selected: rgba(137, 180, 250, 0.15);

    fg: #cdd6f4;
    fg-alt: #bac2de;
    accent: #89b4fa;
    border-color: rgba(137, 180, 250, 0.5);

    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 800px;
    background-color: @bg;
    border: 2px solid;
    border-color: @border-color;
    border-radius: 12px;
    padding: 10px;
}

mainbox {
    background-color: transparent;
    children: [inputbar, message, listview];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 12px;
    margin: 10px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    font: "FiraCode Nerd Font Bold 14";
    margin: 0px 10px 0px 0px;
}

entry {
    font: "FiraCode Nerd Font 14";
    placeholder: "Search Apps, 󰪚 Math, or !k Keys...";
    placeholder-color: @fg-alt;
    text-color: @fg;
}

message {
    background-color: @bg-selected;
    border-radius: 8px;
    margin: 0px 10px 10px 10px;
    padding: 10px;
}

textbox {
    text-color: @accent;
    font: "FiraCode Nerd Font Bold 12";
}

listview {
    background-color: transparent;
    margin: 0px 10px 10px 10px;
    lines: 8;
    columns: 1;
    fixed-height: false;
}

element {
    padding: 12px;
    background-color: transparent;
    border-radius: 8px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-selected;
    text-color: @accent;
    border: 1px solid;
    border-color: @border-color;
}

element-icon {
    size: 24px;
    margin: 0px 15px 0px 0px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
